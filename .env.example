# ═══════════════════════════════════════════════════════════
# MediConnect — Environment Variables Template
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# Rotate all keys before going to production.
#
# cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...REPLACE_ME

# ─── Database (Supabase PostgreSQL) ───────────────────────
# Transaction mode (PgBouncer) — used at runtime by Prisma
DATABASE_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true

# Direct connection — used only by `prisma migrate` / `prisma db push`
DIRECT_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Paystack ─────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
# Use test keys during development, live keys in production
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
# Generate a random 32+ char string: openssl rand -hex 32
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ─── Upstash Redis (for production rate limiting) ─────────
# Sign up at https://upstash.com — required for multi-instance deployments
# Leave empty to fall back to in-memory rate limiting (single-process only)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
